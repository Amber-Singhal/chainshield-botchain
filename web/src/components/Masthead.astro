---
---

<header class="masthead">
  <div class="brand">
    <span class="brand-mark">ChainShield</span>
    <span class="brand-divider"></span>
    <span class="brand-tag">Risk Gate / v0.1</span>
  </div>
  <div class="masthead-status">
    <span class="status-dot"></span>
    <span class="status-text">Operational</span>
    <span class="masthead-clock" id="clock">00:00:00</span>
    <div class="wallet-bar" id="wallet-bar">
      <button type="button" class="btn-chip" data-action="connect-wallet" id="connect-wallet">Connect wallet</button>
      <div id="wallet-info" class="wallet-info" style="display:none">
        <span id="wallet-address" class="wallet-address"></span>
        <span id="wallet-balance" class="wallet-balance"></span>
        <button type="button" class="btn-chip btn-disconnect" data-action="disconnect-wallet" id="disconnect-wallet">Disconnect</button>
      </div>
    </div>
  </div>
</header>
