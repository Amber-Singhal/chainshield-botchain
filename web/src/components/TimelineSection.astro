---

<section class="section" id="section-timeline">
  <header class="section-header">
    <span class="section-num">03 / Timeline</span>
    <div>
      <h2 class="section-title">Every <em>decision</em>, in order</h2>
      <p class="section-lede">Session trail and live on-chain audit feed</p>
    </div>
    <div class="section-actions">
      <button type="button" class="btn-ghost" data-action="refresh-timeline">Refresh</button>
    </div>
  </header>

  <div class="timeline-grid">
    <div class="timeline-col">
      <h3 class="timeline-col-title">Session decisions</h3>
      <div id="timeline-rows" class="timeline"></div>
      <div id="timeline-empty" class="timeline-empty">No decisions recorded yet — submit an intent in section 02.</div>
    </div>
    <div class="timeline-col">
      <h3 class="timeline-col-title">Live on-chain feed</h3>
      <div id="onchain-feed" class="timeline"></div>
      <div id="onchain-feed-empty" class="timeline-empty">Loading on-chain decisions…</div>
    </div>
  </div>
</section>
